# This is run when the user runs `make` without any arguments.
# It handles all work that generates non-committed autogenerated code that
# should be run on any new branch.
dynamic:
	@$(MAKE) pulldeps
	@$(MAKE) format
	@$(MAKE) project

# Install all project dependencies and create the project file, and point git
# at the repo's .githooks/ directory.
bootstrap:
	@git config --local core.hooksPath .githooks
	@brew install --quiet mint
	@mint bootstrap --link
	@ln -sf ~/.mint/bin/swiftformat /opt/homebrew/bin/swiftformat-mint
	@$(MAKE) dynamic

# Close any currently-open project in Xcode before regenerating the .xcodeproj
# file, and re-open. If the script fails, the project does not re-open and it
# simply regenerates the project.
project:
	@test $(shell osascript bin/kill-xcode.applescript "$(xcodeproj_path)" 2>/dev/null) && ($(MAKE) xcodegen && sleep 1 && open -g "$(xcodeproj_path)") || $(MAKE) xcodegen

# The actual invocation of `xcodegen`
xcodegen:
	@mint run xcodegen
	@mkdir -p WeatherShmeather.xcodeproj/project.xcworkspace/xcshareddata
	@cp bin/settings/WorkspaceSettings.xcsettings WeatherShmeather.xcodeproj/project.xcworkspace/xcshareddata/.

# Used to run the Swift formatter on all swift files that are different from
# HEAD. The `grep -v '^.D '` filter drops deletions (worktree ` D ` and index `D  `),
# whose paths no longer exist on disk. The `sed 's/.* -> //'` collapses rename
# entries (`old -> new`) down to just the new path so swiftformat doesn't try
# to open the literal `old -> new` string as one path.
format:
	@echo "🔧 Formatting Swift files..."
	@git status -s --porcelain '*.swift' | grep -v '^.D ' | sed s/^...// | sed 's/.* -> //' | tr '\n' '\0' | xargs -0 -r mint run swiftformat --quiet --config .swiftformat

# Used to manually run the Swift formatter on all swift files in the package.
formatAll:
	@echo "🔧 Formatting all Swift files..."
	@mint run swiftformat --quiet --config .swiftformat .

# Run any time `dependencies.yml` is updated. Pulls latest versions and emits
# `.project-dependencies.yml`.
pulldeps:
	@mint run velocity pull-dependencies --abort-if-unchanged --verbose
	@mint run velocity generate-xcodegen-deps \
		--dependency-output-path local \
		--output-filename .project-dependencies.yml \
		--verbose

# Regenerate `Modules/Package.swift` from `.imports.yml` + `.package.yml`.
package:
	@mint run velocity generate-package \
	    --regen-imports \
		--warnings-as-errors \
		--root-path Modules \
		--platforms ".iOS(.v26)" \
		--swift-tools-version 6.2 \
		--dependency-output-path local \
		--verbose
	@mint run swiftformat --quiet Modules/Package.swift

# Rewrite every `.imports.yml` by scanning actual `import` statements.
imports:
	@mint run velocity generate-imports \
		--search-path Modules

# Regenerate `Modules/Injection/Injection/Injection.swift`.
injection:
	@mint run velocity generate-inject \
		--modules-path Modules \
		--output-file Modules/Injection/Injection/Injection.swift \
		--inject-main-actor \
		--verbose
	@mint run swiftformat --quiet Modules/Injection/Injection/Injection.swift

# Composite: anything you touch under `Modules/` should be followed by `modules`.
modules:
	@$(MAKE) imports
	@$(MAKE) injection
	@$(MAKE) resources
	@$(MAKE) package

# Resource generation for xcassets / strings / etc. inside each module.
resources:
	@mint run velocity generate-resources \
		--modules-path Modules \
		--swift-package Modules \
		--output-resource-manifest .cache/resource_manifest.txt
	@$(MAKE) format

# Run the Slate generator after changing a `@SlateEntity` model. Generated files
# land in the owning module's `Generated/` directory. Run `make modules`
# afterwards if a model gained or lost a property.
models:
	@bin/scripts/gen_logging_model.sh
	@bin/scripts/gen_manager_model.sh Places
	@$(MAKE) format

# Run the module test targets on the simulator. `swift test` can't build modules
# that import UIKit. Override TEST_DESTINATION to pick another simulator.
test:
	@cd Modules && xcodebuild test -quiet \
		-scheme Modules-Package \
		-destination '$(TEST_DESTINATION)' \
		-collect-test-diagnostics never

.PHONY: project \
		xcodegen \
		format \
		formatAll \
		modules \
		package \
		imports \
		injection \
		resources \
		models \
		test \
		pulldeps \
		dynamic \
		bootstrap

xcodeproj_file := "WeatherShmeather.xcodeproj"
xcodeproj_path := $(abspath $(xcodeproj_file))
TEST_DESTINATION ?= platform=iOS Simulator,name=iPhone 17 Pro,OS=26.5
